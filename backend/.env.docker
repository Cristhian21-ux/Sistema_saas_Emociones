APP_NAME="Emociones SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es

# Una sola empresa/centro: sin registro público de centros ni planes (igual que en desarrollo).
MODO_CENTRO_UNICO=true

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=emociones_saas
DB_USERNAME=app_user

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

IA_SERVICE_URL=http://ia-service:8001
IA_SERVICE_TIMEOUT=5
