# Copia este archivo como ".env" en la carpeta del proyecto, en el servidor, y completa los valores.
# NUNCA lo subas a git. Usa valores largos y aleatorios (por ejemplo: openssl rand -base64 32).

# Dominio público (debe apuntar a la IP del servidor para obtener el certificado HTTPS).
DOMINIO=app.tucentro.com

# Llave de cifrado de Laravel. Genérala UNA sola vez:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Respáldala fuera del servidor: si se pierde, las historias clínicas cifradas no se pueden recuperar.
APP_KEY=

DB_PASSWORD=
DB_ROOT_PASSWORD=
IA_SERVICE_KEY=

# true = una sola empresa (sin registro público). false = SaaS multi-centro con planes y registro abierto.
MODO_CENTRO_UNICO=true

# Días que se conservan los respaldos diarios en ./backups
RETENCION_DIAS=14
